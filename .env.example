# Optional: enables AI-generated dialogue in the simulation via OpenRouter (https://openrouter.ai).
# Copy this file to .env and paste your OpenRouter API key. The key is read only by the local
# Vite dev/preview server (server/llmProxy.ts) and never reaches the browser bundle.
# Without it the game uses procedural dialogue, exactly as before.
OPENROUTER_API_KEY=

# Optional: comma-separated model ids, tried in order (max 3). Default: free models only
# (nvidia/nemotron-3.5-super-vl:free, google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free).
# A paid model (no ":free" suffix) is used only if you list it here yourself.
OPENROUTER_MODELS=

# Optional: max requests per UTC day sent by the proxy (default 180). The proxy also adopts the
# account's own free-model quota from OpenRouter at startup (50/day, or 1000/day after buying credits).
OPENROUTER_DAILY_LIMIT=

# Optional: comma-separated RSS/Atom feed URLs for the TV news headlines (GET /api/news, fetched
# server-side, cached 15 min). Empty = default public Polish feeds (Polsat News, TVN24, RMF24,
# Rzeczpospolita). "off" disables real headlines: the TV then shows only in-game "Wiadomości z osiedla".
NEWS_FEEDS=
